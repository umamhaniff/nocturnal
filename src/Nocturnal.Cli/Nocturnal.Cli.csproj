<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>nocturnal-cli</AssemblyName>
    <Version>1.3.3</Version>
    <Product>Nocturnal CLI</Product>
    <Authors>Hans x Gravi</Authors>
    <Description>Command-line controller for the Nocturnal tray daemon via local Named Pipe IPC.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nocturnal.Core\Nocturnal.Core.csproj" />
  </ItemGroup>
</Project>
