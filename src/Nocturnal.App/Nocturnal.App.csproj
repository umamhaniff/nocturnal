<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Nocturnal</AssemblyName>
    <Version>1.3.1</Version>
    <Product>Nocturnal</Product>
    <Authors>Hans x Gravi</Authors>
    <Description>Lightweight Windows System Tray utility to keep your laptop awake safely for AI agents and timed sessions.</Description>
    <ApplicationIcon>Assets\nocturnal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nocturnal.Core\Nocturnal.Core.csproj" />
  </ItemGroup>
</Project>
