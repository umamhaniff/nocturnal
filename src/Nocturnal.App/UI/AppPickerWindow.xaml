<Window x:Class="Nocturnal.App.UI.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Running App"
        Width="336"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="#FA0E1117"
            BorderBrush="#2A3344"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Pick Running App" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                    <TextBlock Text="Click an app to select it" FontSize="10.5" Foreground="#64748B" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        Width="26"
                        Height="26"
                        Background="#151922"
                        Foreground="#94A3B8"
                        BorderBrush="#262F3F"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Close_Click" />
            </Grid>

            <TextBox x:Name="FilterBox"
                     Grid.Row="1"
                     Background="#0B0E14"
                     Foreground="#F1F5F9"
                     CaretBrush="#34D399"
                     BorderBrush="#262F3F"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="12"
                     Margin="0,0,0,10"
                     TextChanged="FilterBox_TextChanged" />

            <ListBox x:Name="AppsListBox"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="AppsListBox_MouseClick"
                     PreviewMouseLeftButtonUp="AppsListBox_MouseClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="#151922"
                                            BorderBrush="#222936"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1B2230" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#64748B" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#1E2634"
                                    CornerRadius="6"
                                    Padding="7,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding RamLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#6EE7B7" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
