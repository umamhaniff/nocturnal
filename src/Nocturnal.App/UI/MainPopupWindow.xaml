<Window x:Class="Nocturnal.App.UI.MainPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturnal"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Custom Toggle Switch (replaces default Win7 CheckBox) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="38"
                                Height="20"
                                CornerRadius="10"
                                Background="#273040"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Fill="#E2E8F0"
                                     Margin="2,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#10B981" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#34D399" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#059669" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6EE7B7" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Navigation / Style Selector -->
        <Style x:Key="SegmentTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2634" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Preset Button -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B212E" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2A3344" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242D3E" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PresetButtonStyle}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="#062017" />
            <Setter Property="BorderBrush" Value="#34D399" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34D399" />
                    <Setter Property="BorderBrush" Value="#6EE7B7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PresetButtonStyle}">
            <Setter Property="Background" Value="#2A161D" />
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Setter Property="BorderBrush" Value="#5B212C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B1D24" />
                    <Setter Property="BorderBrush" Value="#F87171" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Black Matte Community Footer Buttons -->
        <Style x:Key="MatteGitHubButtonStyle" TargetType="Button" BasedOn="{StaticResource PresetButtonStyle}">
            <Setter Property="Background" Value="#12161E" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#252C3B" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#181E29" />
                    <Setter Property="BorderBrush" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MatteCoffeeButtonStyle" TargetType="Button" BasedOn="{StaticResource PresetButtonStyle}">
            <Setter Property="Background" Value="#0A0C10" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#262C36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#141820" />
                    <Setter Property="BorderBrush" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selectable App Chip -->
        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#151922" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#262F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#112A24" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#6EE7B7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Input Box -->
        <Style x:Key="DarkInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0E14" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#262F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#34D399" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Header Icon Button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2430" />
                                <Setter Property="Foreground" Value="#F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single Elevated Midnight Glass Shell -->
    <Border Background="#F70E1117"
            BorderBrush="#242B38"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Header Bar -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <Path x:Name="LogoCrescent" Fill="#64748B">
                                <Path.Data>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <EllipseGeometry Center="15.2,16" RadiusX="10.2" RadiusY="10.2" />
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <EllipseGeometry Center="20.2,12.8" RadiusX="8.6" RadiusY="8.6" />
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </Path.Data>
                            </Path>
                            <Polyline x:Name="LogoPulse"
                                      Points="9.5,17.8 13.8,17.8 16.4,11.2 19.2,21.4 21.6,16.2 26.0,16.2"
                                      Stroke="#94A3B8"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            <Line x:Name="LogoSlashKnockout"
                                  X1="5.5" Y1="26.5" X2="26.5" Y2="5.5"
                                  Stroke="#F70E1117"
                                  StrokeThickness="5.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line x:Name="LogoSlash"
                                  X1="5.5" Y1="26.5" X2="26.5" Y2="5.5"
                                  Stroke="#F87171"
                                  StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nocturnal" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                        <TextBlock x:Name="HeaderStatusText" Text="Idle" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DisplayOffBtn"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Turn display off (stay awake)"
                            Margin="0,0,4,0"
                            Click="DisplayOff_Click">
                        <Path Data="M2,3 H12 V9.5 H2 Z M5,12 H9 M7,9.5 V12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="14"
                              Height="14" />
                    </Button>
                    <Button x:Name="CompactSettingsBtn"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Open Settings"
                            Visibility="Collapsed"
                            Margin="0,0,4,0"
                            Click="CompactSettingsBtn_Click">
                        <Path Data="M2,4 H12 M2,8 H12 M2,12 H12 M5,2 V6 M9,6 V10 M5,10 V14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="14"
                              Height="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Quit Nocturnal"
                            Click="Exit_Click">
                        <Path Data="M3,3 L11,11 M11,3 L3,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="14"
                              Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Update Available Banner -->
            <Border x:Name="UpdateBannerBorder"
                    Background="#112A24"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,7"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Text="Update available"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#ECFDF5" />
                        <TextBlock x:Name="UpdateBannerSub"
                                   Text="Ready for one-click install"
                                   FontSize="10.5"
                                   Foreground="#6EE7B7" />
                    </StackPanel>
                    <Button x:Name="UpdateBannerBtn"
                            Grid.Column="1"
                            Content="Update"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            VerticalAlignment="Center"
                            Click="InstallUpdate_Click" />
                </Grid>
            </Border>

            <!-- 3-Tab Segmented Navigation -->
            <Border x:Name="TabBarBorder"
                    Background="#151922"
                    BorderBrush="#222936"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="3"
                    Margin="0,0,0,14">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TimerTabBtn"
                                 Content="Timer"
                                 GroupName="NavTabs"
                                 IsChecked="True"
                                 Style="{StaticResource SegmentTabStyle}"
                                 Checked="NavTab_Checked" />
                    <RadioButton x:Name="FocusTabBtn"
                                 Content="Focus"
                                 GroupName="NavTabs"
                                 Style="{StaticResource SegmentTabStyle}"
                                 Checked="NavTab_Checked" />
                    <RadioButton x:Name="SettingsTabBtn"
                                 Content="Settings"
                                 GroupName="NavTabs"
                                 Style="{StaticResource SegmentTabStyle}"
                                 Checked="NavTab_Checked" />
                </UniformGrid>
            </Border>

            <!-- TAB 1: TIMER -->
            <StackPanel x:Name="TimerPanel">
                <!-- Radial Countdown Hero -->
                <Grid Width="146" Height="146" HorizontalAlignment="Center" Margin="0,2,0,14">
                    <Canvas Width="146" Height="146">
                        <Ellipse Width="132" Height="132"
                                 Canvas.Left="7" Canvas.Top="7"
                                 Stroke="#1E2634"
                                 StrokeThickness="6" />
                        <Ellipse x:Name="CountdownRingFull"
                                 Width="132" Height="132"
                                 Canvas.Left="7" Canvas.Top="7"
                                 Stroke="#10B981"
                                 StrokeThickness="6"
                                 Visibility="Collapsed" />
                        <Path x:Name="CountdownRingArc"
                              Stroke="#10B981"
                              StrokeThickness="6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure x:Name="CountdownArcFigure" StartPoint="73,7" IsClosed="False">
                                        <ArcSegment x:Name="CountdownArcSegment"
                                                    Point="73,7"
                                                    Size="66,66"
                                                    IsLargeArc="False"
                                                    SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusTitleText"
                                   Text="Idle"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F5F9"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatusSubText"
                                   Text="Pick duration"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Quick Duration Presets -->
                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Button Content="+15m" Style="{StaticResource PresetButtonStyle}" Margin="0,0,4,0" Click="Preset15m_Click" />
                    <Button Content="+30m" Style="{StaticResource PresetButtonStyle}" Margin="2,0,2,0" Click="Preset30m_Click" />
                    <Button Content="+1h" Style="{StaticResource PresetButtonStyle}" Margin="2,0,2,0" Click="Preset1h_Click" />
                    <Button Content="+4h" Style="{StaticResource PresetButtonStyle}" Margin="4,0,0,0" Click="Preset4h_Click" />
                </UniformGrid>

                <!-- Custom Duration Strip -->
                <Border x:Name="CustomDurationPanel"
                        Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Days" FontSize="10" Foreground="#64748B" Margin="2,0,0,3" />
                            <TextBox x:Name="DaysBox" Text="0" TextAlignment="Center" Style="{StaticResource DarkInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Hrs" FontSize="10" Foreground="#64748B" Margin="2,0,0,3" />
                            <TextBox x:Name="HoursBox" Text="1" TextAlignment="Center" Style="{StaticResource DarkInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Mins" FontSize="10" Foreground="#64748B" Margin="2,0,0,3" />
                            <TextBox x:Name="MinutesBox" Text="0" TextAlignment="Center" Style="{StaticResource DarkInputStyle}" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="Start"
                                VerticalAlignment="Bottom"
                                Padding="14,6"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="StartCustom_Click" />
                    </Grid>
                </Border>

                <!-- Process Watcher ("Awake Until Done") -->
                <Border x:Name="WatchProcessPanel"
                        Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Awake until process exits (e.g. python, dotnet)"
                                   FontSize="10.5"
                                   Foreground="#64748B"
                                   Margin="2,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WatchProcessBox"
                                     Style="{StaticResource DarkInputStyle}"
                                     KeyDown="WatchProcessBox_KeyDown"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Watch"
                                    Padding="12,5"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Click="WatchProcess_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Toggles Card -->
                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Clamshell Mode" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="Stay awake with lid closed" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <CheckBox x:Name="ClamshellSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="ClamshellSwitch_Click" />
                        </Grid>

                        <Border Height="1" Background="#1E2430" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Agent Focus" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock x:Name="FocusSummaryText" Text="Throttle non-agent apps" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <CheckBox x:Name="AgentFocusSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="AgentFocusSwitch_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Telemetry + History + Stop Button -->
                <TextBlock x:Name="TelemetryText"
                           Text="AC • 100%"
                           FontSize="11"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" />

                <TextBlock x:Name="LastSessionText"
                           Text="No recent sessions"
                           FontSize="10.5"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <Button x:Name="StopButton"
                        Content="Stop &amp; Restore Power"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="Stop_Click"
                        Visibility="Collapsed" />
            </StackPanel>

            <!-- TAB 2: AGENT FOCUS -->
            <StackPanel x:Name="FocusPanel" Visibility="Collapsed">
                <Border x:Name="FocusTelemetryBorder"
                        Background="#112A24"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,7"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="FocusTelemetryText"
                               Text="Reclaimed 0 MB RAM"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#6EE7B7"
                               HorizontalAlignment="Center" />
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="EcoQoS + RAM Trim" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="Throttle &amp; trim idle RAM of non-agent apps" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <CheckBox x:Name="EcoQosSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="EcoQosSwitch_Click" />
                        </Grid>

                        <Border Height="1" Background="#1E2430" Margin="0,0,0,10" />

                        <StackPanel>
                            <TextBlock Text="Selected Apps Action" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                            <TextBlock Text="Pause freezes &amp; auto-resumes; Close sends graceful close" FontSize="11" Foreground="#64748B" Margin="0,1,0,8" />
                            <Border Background="#0E121A" BorderBrush="#222936" BorderThickness="1" CornerRadius="9" Padding="3">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ModeOffRadio" Content="Off" Tag="Off" GroupName="SelectedAppModeGroup" Style="{StaticResource SegmentTabStyle}" Checked="SelectedAppModeRadio_Checked" />
                                    <RadioButton x:Name="ModePauseRadio" Content="Pause" Tag="DeepPause" GroupName="SelectedAppModeGroup" Style="{StaticResource SegmentTabStyle}" Checked="SelectedAppModeRadio_Checked" />
                                    <RadioButton x:Name="ModeCloseRadio" Content="Close" Tag="GracefulClose" GroupName="SelectedAppModeGroup" Style="{StaticResource SegmentTabStyle}" Checked="SelectedAppModeRadio_Checked" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Selected Apps" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,8" />
                        <WrapPanel x:Name="AppChipsPanel">
                            <ToggleButton Content="Discord" Tag="Discord" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Spotify" Tag="Spotify" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Steam" Tag="Steam" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="WhatsApp" Tag="WhatsApp,WhatsApp.Root" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Telegram" Tag="Telegram" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Teams" Tag="Teams,ms-teams" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Slack" Tag="Slack" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                            <ToggleButton Content="Browsers" Tag="chrome,msedge,brave,firefox,opera,arc" ToolTip="User browsers only — AI agent &amp; Playwright browsers stay protected" Style="{StaticResource ChipToggleStyle}" Click="AppChip_Click" />
                        </WrapPanel>
                        <TextBlock Text="Extra Apps (comma-separated)" FontSize="10.5" Foreground="#64748B" Margin="0,4,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomAppsBox"
                                     Style="{StaticResource DarkInputStyle}"
                                     LostFocus="CustomAppsBox_LostFocus"
                                     KeyDown="CustomAppsBox_KeyDown"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="1"
                                    Content="Save"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Padding="10,5"
                                    Click="SaveCustomApps_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Extra Agent Whitelist" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomWhitelistBox"
                                     Style="{StaticResource DarkInputStyle}"
                                     LostFocus="CustomWhitelistBox_LostFocus"
                                     KeyDown="CustomWhitelistBox_KeyDown"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="1"
                                    Content="Save"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Padding="10,5"
                                    Click="SaveWhitelist_Click" />
                        </Grid>
                        <TextBlock Text="Protects process trees &amp; remote desktop (agy, Claude, Gemini, Codex, Node, Python, Docker, Terminal, VS Code, Chrome Remote Desktop)."
                                   TextWrapping="Wrap"
                                   FontSize="10.5"
                                   Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 3: SETTINGS -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tray UI Style" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="2,0,0,8" />
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="StylePillsRadio" Content="Pills" Tag="Pills" GroupName="TrayStyleGroup" Style="{StaticResource SegmentTabStyle}" Checked="TrayStyleRadio_Checked" />
                            <RadioButton x:Name="StyleCompactRadio" Content="Compact" Tag="Compact" GroupName="TrayStyleGroup" Style="{StaticResource SegmentTabStyle}" Checked="TrayStyleRadio_Checked" />
                            <RadioButton x:Name="StyleMinimalRadio" Content="Minimal" Tag="Minimal" GroupName="TrayStyleGroup" Style="{StaticResource SegmentTabStyle}" Checked="TrayStyleRadio_Checked" />
                            <RadioButton x:Name="StylePopoverRadio" Content="Popover" Tag="Popover" GroupName="TrayStyleGroup" Style="{StaticResource SegmentTabStyle}" Checked="TrayStyleRadio_Checked" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-sleep when timer expires" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoSleepSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="AutoSleepSwitch_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Keep display awake" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <CheckBox x:Name="KeepDisplaySwitch" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="KeepDisplaySwitch_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thermal protection (80°C / 95°C)" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <CheckBox x:Name="ThermalGuardSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="ThermalGuardSwitch_Click" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Launch at Windows startup" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="StartupSwitch_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Low Power %" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,3" />
                            <TextBox x:Name="LowPowerPctBox" Text="40" TextAlignment="Center" Style="{StaticResource DarkInputStyle}" LostFocus="BatteryThreshold_LostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Critical Sleep %" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,3" />
                            <TextBox x:Name="CriticalPctBox" Text="10" TextAlignment="Center" Style="{StaticResource DarkInputStyle}" LostFocus="BatteryThreshold_LostFocus" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#151922"
                        BorderBrush="#222936"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-check for updates" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoUpdateSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="AutoUpdateSwitch_Click" />
                        </Grid>

                        <Border Height="1" Background="#1E2430" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="VersionText" Text="Nocturnal v1.2.0" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock x:Name="UpdateStatusText" Text="Check GitHub Releases" FontSize="10.5" Foreground="#64748B" />
                            </StackPanel>
                            <Button x:Name="CheckUpdateBtn"
                                    Grid.Column="1"
                                    Content="Check"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Padding="12,5"
                                    VerticalAlignment="Center"
                                    Click="CheckOrInstallUpdate_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Community Footer: Star on GitHub + Support (Coffee Black Matte) -->
            <Border x:Name="CommunityFooterBorder"
                    BorderBrush="#1E2430"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0"
                    Margin="0,12,0,0">
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource MatteGitHubButtonStyle}"
                            Margin="0,0,4,0"
                            Click="StarGitHub_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M7,0.8 L8.9,4.7 L13.2,5.3 L10.1,8.3 L10.8,12.6 L7,10.5 L3.2,12.6 L3.9,8.3 L0.8,5.3 L5.1,4.7 Z"
                                  Fill="#E2E8F0"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Star on GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MatteCoffeeButtonStyle}"
                            Margin="4,0,0,0"
                            Click="SupportCoffee_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M4.8,2.2 C4.3,3.0 5.3,3.5 4.8,4.3 M7.8,1.8 C7.3,2.6 8.3,3.1 7.8,3.9"
                                      Stroke="#94A3B8"
                                      StrokeThickness="1.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M2.5,5.5 H10.5 V9.5 C10.5,11.6 8.8,13.0 6.5,13.0 C4.2,13.0 2.5,11.6 2.5,9.5 Z"
                                      Fill="#151922"
                                      Stroke="#E2E8F0"
                                      StrokeThickness="1.3"
                                      StrokeLineJoin="Round" />
                                <Path Data="M10.5,6.5 H12.0 C12.9,6.5 13.5,7.2 13.5,8.2 C13.5,9.2 12.9,9.9 12.0,9.9 H10.5"
                                      Stroke="#E2E8F0"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Line X1="2.0" Y1="14.2" X2="11.2" Y2="14.2"
                                      Stroke="#94A3B8"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                            <TextBlock Text="Support" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
